/*
 * 深色磨砂玻璃主题
 * Dark Glass / Acrylic Theme for COC & DND Character Manager
 */

/* ===== 全局 ===== */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0d0d1a, stop:1 #1a1a2e);
}

QWidget {
    color: rgba(255, 255, 255, 0.85);
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* ===== 导航栏 ===== */
#navPanel {
    background: rgba(255, 255, 255, 0.05);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
}

#navTitle {
    color: rgba(255, 255, 255, 0.4);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
    padding: 20px 14px 8px 14px;
    text-transform: uppercase;
}

QPushButton#navButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    text-align: left;
    font-size: 13px;
    margin: 2px 8px;
}

QPushButton#navButton:hover {
    background: rgba(108, 99, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
}

QPushButton#navButton:checked {
    background: rgba(108, 99, 255, 0.22);
    color: #ffffff;
    border-left: 3px solid #6c63ff;
}

/* ===== 搜索栏 ===== */
#searchBar {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    padding: 8px 18px;
    color: white;
    font-size: 13px;
    min-height: 20px;
}

#searchBar:focus {
    border: 1px solid rgba(108, 99, 255, 0.45);
    background: rgba(255, 255, 255, 0.10);
}

/* ===== 下拉框 ===== */
QComboBox {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 6px 14px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
    min-width: 70px;
}

QComboBox:hover {
    border: 1px solid rgba(108, 99, 255, 0.35);
}

QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid rgba(255, 255, 255, 0.4);
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background: #1a1a30;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    selection-background-color: rgba(108, 99, 255, 0.25);
    color: rgba(255, 255, 255, 0.85);
    padding: 6px;
    outline: none;
}

/* ===== 卡片 ===== */
#cardWidget {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    padding: 16px;
    min-width: 200px;
    max-width: 240px;
    min-height: 180px;
}

#cardWidget:hover {
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(108, 99, 255, 0.25);
}

#modeIndicator {
    font-size: 10px;
    font-weight: 700;
    color: #6c63ff;
    background: rgba(108, 99, 255, 0.12);
    border-radius: 4px;
    padding: 2px 10px;
}

#titleLabel {
    font-size: 22px;
    font-weight: 700;
    color: white;
}

#subtitleLabel {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
}

#statLabel {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
}

/* ===== 按钮 ===== */
QPushButton#actionButton {
    background: rgba(108, 99, 255, 0.18);
    border: 1px solid rgba(108, 99, 255, 0.25);
    border-radius: 10px;
    padding: 8px 20px;
    color: white;
    font-weight: 500;
    font-size: 13px;
}

QPushButton#actionButton:hover {
    background: rgba(108, 99, 255, 0.32);
    border: 1px solid rgba(108, 99, 255, 0.45);
}

QPushButton#actionButton:pressed {
    background: rgba(108, 99, 255, 0.45);
}

QPushButton#dangerButton {
    background: rgba(255, 60, 60, 0.12);
    border: 1px solid rgba(255, 60, 60, 0.2);
    border-radius: 10px;
    padding: 8px 20px;
    color: #ff6666;
    font-weight: 500;
    font-size: 13px;
}

QPushButton#dangerButton:hover {
    background: rgba(255, 60, 60, 0.25);
}

QPushButton#sortButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 11px;
}

QPushButton#sortButton:hover {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.75);
}

QPushButton#sortButton:checked {
    background: rgba(108, 99, 255, 0.18);
    border: 1px solid rgba(108, 99, 255, 0.25);
    color: white;
}

/* ===== 文本输入框 ===== */
QLineEdit, QTextEdit, QPlainTextEdit {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 10px 14px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
    selection-background-color: rgba(108, 99, 255, 0.25);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid rgba(108, 99, 255, 0.35);
}

/* ===== 滚动条 ===== */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.2);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* ===== 分组框 ===== */
QGroupBox {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 14px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
}

/* ===== 标签页 ===== */
QTabWidget::pane {
    background: rgba(0, 0, 0, 0.15);
    border: none;
    border-radius: 8px;
    padding: 8px;
}

QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.4);
    border: none;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: white;
    border-bottom: 2px solid #6c63ff;
}

QTabBar::tab:hover {
    color: rgba(255, 255, 255, 0.7);
}

/* ===== 消息框 ===== */
QMessageBox {
    background: #16162a;
    border-radius: 12px;
}

QMessageBox QLabel {
    color: white;
}

QMessageBox QPushButton {
    background: rgba(108, 99, 255, 0.18);
    border: 1px solid rgba(108, 99, 255, 0.25);
    border-radius: 8px;
    padding: 6px 20px;
    color: white;
    min-width: 60px;
}

QMessageBox QPushButton:hover {
    background: rgba(108, 99, 255, 0.32);
}

/* ===== 分割线 ===== */
#divider {
    background: rgba(255, 255, 255, 0.06);
    max-height: 1px;
}

/* ===== 输入数字框 ===== */
QSpinBox {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 8px;
    color: white;
    min-width: 60px;
}

QSpinBox:focus {
    border: 1px solid rgba(108, 99, 255, 0.35);
}

QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    background: transparent;
    width: 16px;
}

/* ===== 对话框 ===== */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0d0d1a, stop:1 #1a1a2e);
}

/* ===== 输入对话框 ===== */
QInputDialog QLineEdit {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 8px 12px;
    color: white;
}
